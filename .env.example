# Plant Protection Agent — 环境变量示例
# 复制为 .env 并按需修改

# LLM 配置
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=qwen2.5-vl-72b-instruct
LLM_BASE_URL=https://api.example.com/v1

# LangGraph
LANGGRAPH_DEBUG=false
LANGGRAPH_MAX_RECURSION=25

# 视觉模块
VLM_ENABLED=false
VLM_MODEL_PATH=models/vlm/

# 检索模块
RETRIEVER_TYPE=keyword  # keyword | vector | hybrid
VECTOR_DB_PATH=data/vectors/

# 应用
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
