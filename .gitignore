# Plant Protection Agent — .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environment
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Git
$RECYCLE.BIN/
System Volume Information/

# Large data / staging
knowledge/sources/staging/*
!knowledge/sources/staging/.gitkeep

# Logs
*.log
